# AdaptAI — modelo de variáveis de ambiente.
# Copie para ".env" na raiz (cp .env.example .env) e preencha. NUNCA versione o ".env".
# Variáveis marcadas como OBRIGATÓRIAS fazem o "docker compose up" falhar se estiverem vazias.

# ---------- Aplicação ----------
ADAPTAI_ENV=dev                 # dev | demo | prod
ADAPTAI_MODO_DEMO=false         # true aplica fator 0,1 aos limiares de XP (RN-16)

# ---------- Segurança ----------
# OBRIGATÓRIA. NUNCA versione um valor real. Gere com: openssl rand -hex 32
JWT_SECRET=chave-de-exemplo-apenas-para-dev
JWT_EXPIRA_MIN=60
CORS_ORIGINS=http://localhost
MAX_UPLOAD_MB=10

# ---------- Banco (PostgreSQL com pgvector, no Compose) ----------
# OBRIGATÓRIAS. Use apenas letras e números (a senha entra na DATABASE_URL sem codificação).
POSTGRES_USER=adaptai
POSTGRES_PASSWORD=adminadaptai
POSTGRES_DB=adaptai

# ---------- Armazenamento ----------
STORAGE_BACKEND=local             # local | oci
LOCAL_STORAGE_DIR=.local-storage

# OCI Object Storage — só necessário com STORAGE_BACKEND=oci
OCI_REGION=
OCI_TENANCY=
OCI_USER=
OCI_FINGERPRINT=
OCI_KEY_FILE=
OCI_NAMESPACE=
OCI_BUCKET=adaptai-conteudos-educativos

# ---------- LLM e embeddings (ADR-0011, decisão pendente) ----------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=sua_chave_aqui_do_google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
SPIKE_PAUSA=5

LLM_API_KEY=
GROQ_API_KEY=

# ---------- Front-end (T5 / US-003) ----------
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000/api/v1
