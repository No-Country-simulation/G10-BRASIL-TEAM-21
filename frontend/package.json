{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run mocks:sync",
    "build": "npm run mocks:sync && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../backend/docs/openapi.json -o src/api/schema.d.ts",
    "gerar:tipos": "npm run gen:api",
    "check:api": "node scripts/verificar-api.mjs",
    "mocks:sync": "node scripts/sincronizar-mocks.mjs",
    "typecheck": "tsc -b",
    "test": "npm run mocks:sync && vitest run"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
